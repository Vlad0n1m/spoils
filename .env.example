# SPOILS environment. Copy to .env (repo root; the web, the game server, drizzle and docker compose
# all read it) and fill it in. Values are never committed. Generate secrets with: openssl rand -hex 32
# Keep it private to your user: chmod 600 .env (cp creates it world-readable).
#
# Lines written `NAME=` are read as "unset" when left empty. Lines written `# NAME=` must stay
# commented unless you set a real value: an empty value there would change behaviour.
# "dev:" notes give a working local value.

# ── Database ─────────────────────────────────────────────────────────────────────────────────────
# Postgres URL; the path segment after :port IS the database name (dev: postgresql://postgres:postgres@127.0.0.1:5432/extract).
# Create the DB once: createdb extract. URL-encode special characters in the password (! → %21, @ → %40).
# docker compose ignores this value and builds its own URL from POSTGRES_PASSWORD.
DATABASE_URL=
# docker compose only: password of the bundled postgres (unset → "postgres"; set a strong one on a VPS).
POSTGRES_PASSWORD=
# Web DB tests only; the name must contain "test" (unset → postgresql://localhost:5432/extract_test).
# TEST_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────────────────────────
# iron-session secret, 32+ characters (production refuses a shorter one: sessions would be forgeable).
SESSION_SECRET=
# Optional: force the Secure cookie flag (true|false). Default: on for https (X-Forwarded-Proto) / production.
SESSION_COOKIE_SECURE=
# Bearer token of /api/cron/** (Vercel Cron sends it; the compose `cron` service too).
# Required in production, 16+ characters: the web refuses to start without it. Optional in dev.
CRON_SECRET=
# Optional alert webhook of the nightly invariant check (/api/cron/invariants): a Slack or Discord
# incoming webhook URL. Failures are always logged as "[invariants] FAILED …"; with this set they are posted too.
ALERT_WEBHOOK_URL=

# ── Web <-> game server ──────────────────────────────────────────────────────────────────────────
# Shared HMAC secret of the join tickets and the server → web reports, 16+ (use 64 hex) characters.
# Same value in the web and the game server; required in production by both.
GAME_SERVER_HMAC_SECRET=
# Game server → web API origin (dev: http://127.0.0.1:3001; compose sets http://web:3000).
# Required in production; unset in dev → the game server plays offline (free kits, nothing settled).
WEB_API_BASE_URL=
# WORLD v6: stable id of this game server (e.g. world-1). Required in production (boot fails without it);
# a newer boot under the same id voids the maps of the previous process. Compose defaults it to world-1.
GAME_SERVER_ID=
# WORLD v6, optional: boss-schedule secret (64 hex). Unset → derived from GAME_SERVER_HMAC_SECRET.
# Never reuse MASTER_SEED_HEX.
WORLD_SEED_SECRET=
# Game server listen port (unset → 2567).
# GAME_SERVER_PORT=
# Admin replays: the game server records every world shard-cycle and posts it to the web (on whenever
# WEB_API_BASE_URL is set). 0 turns the recording off.
# REPLAY_RECORD=0

# ── Public (baked into the client at build: rebuild the web image / redeploy after a change) ─────
# Colyseus URL the browser connects to (unset → ws://localhost:2567, fine for dev).
# Production: set it to wss://game.<your domain> before building the web image.
# NEXT_PUBLIC_GAME_SERVER_URL=
# Optional, server-only: JSON map ISO country → wss URL. WORLD v6 runs one world on one server: keep unset.
GAME_SERVER_URL_BY_COUNTRY=
# Solana RPC and cluster for the browser wallet (compose defaults: devnet).
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=
# Market currency label (unset → SOL).
NEXT_PUBLIC_MARKET_CURRENCY=
# Public https origin of the site, e.g. https://<your domain> (absolute og:url / og:image for link
# previews); unset → relative links only, no preview image.
NEXT_PUBLIC_SITE_URL=
# Guest play without a wallet: NEXT_PUBLIC_GUEST_PLAY=1 (UI + API) and/or GUEST_PLAY_ENABLED=true (API).
NEXT_PUBLIC_GUEST_PLAY=
GUEST_PLAY_ENABLED=
# Wallet "Add $100" test top-up: 1|true on, 0|false off; unset → on only in `next dev`.
# Production refuses it (route + preflight) unless WALLET_DEV_TOPUP_PRODUCTION=1 on a non-mainnet demo stack.
NEXT_PUBLIC_WALLET_DEV_TOPUP=
# Server-only: allow the dev top-up in a production runtime (a devnet demo, on purpose). Never on mainnet.
WALLET_DEV_TOPUP_PRODUCTION=

# ── Solana (server) ──────────────────────────────────────────────────────────────────────────────
# Server RPC URL and cluster (unset → https://api.devnet.solana.com, devnet).
SOLANA_RPC_URL=
SOLANA_CLUSTER=
# Hot wallet (base58 secret key) for withdrawals; unset → withdrawals disabled.
HOT_WALLET_SECRET_B58=
# 64 hex chars (32 bytes). Per-user deposit keys = HMAC-SHA512(master, userId). Required in production
# for wallet registration. Never change it after launch: deposit addresses are derived from it.
MASTER_SEED_HEX=
# Public host(s) of this deployment, space or comma separated (e.g. spoils.example; the iDos edition's
# own env file lists idos.spoils.example): the only domains a Sign-In with Solana message (wallet
# linking) may name. Unset → localhost only, so set it wherever players link wallets.
SIWS_ALLOWED_HOSTS=

# ── On-chain game results (README "On-chain") ────────────────────────────────────────────────────
# Record signer of the spoils_events program: base58 secret key or a solana-keygen JSON array. It pays
# the fees of /api/cron/chain-events; unset → events stay queued (in every environment, dev too).
CHAIN_AUTHORITY_SECRET=
# Secret salt of the user hashes written on chain; required in production (dev: a fixed dev salt).
# Never change it after launch: older hashes would no longer match the same player.
CHAIN_HASH_SALT=
# Program id and RPC of its cluster (unset → the devnet deployment and SOLANA_RPC_URL / devnet).
CHAIN_PROGRAM_ID=
CHAIN_RPC_URL=
# Explorer cluster of the links on /economy (unset → devnet).
CHAIN_CLUSTER=

# ── Economy switches (leave unset for the live rules) ────────────────────────────────────────────
# Seller fee override in basis points (unset → MARKET.FEE_BPS from @extract/shared).
MARKET_FEE_BPS=
# Lot visibility delay override in ms (unset → the shared default; 0 with ECONOMY_DEMO_RULES=1).
MARKET_VISIBLE_DELAY_MS=
# Jury demo rules on the web: 1 → on.
ECONOMY_DEMO_RULES=
# Game server: demo → demo shards (free kits, server-minted uniques); unset → live.
ECONOMY_MODE=

# ── iDos Games edition (docs/IDOS_EDITION.md, deploy/idos.compose.yml) ─────────────────────────────
# Only in the edition's own env file .env.idos.local (gitignored), never in the main .env. Both are
# fixed at build: rebuild the edition web image after a change.
# 1 → "SPOILS — iDos Games edition": inlines NEXT_PUBLIC_IDOS_BUILD=1, iframe headers, cross-site
# session cookie (SameSite=None; Secure; Partitioned). Unset → the main build, unchanged.
IDOS_BUILD=
# Sites allowed to frame the edition, space or comma separated https origins; replaces the default.
# Unset → https://idosgames.com https://www.idosgames.com only. Add the exact iDos shell origin of our
# title (https://<titleid>.idos.games) once it exists; https://*.idos.games would let every title
# hosted there frame the logged-in edition, so use a wildcard only on purpose.
IDOS_FRAME_ANCESTORS=
# iDos Title ids whose shell (https://<titleid>.idos.games) may sign players in, e.g. ABCD1234-DEV or
# "ABCD1234 ABCD1234-DEV". Read at build (shell origins for the page and frame-ancestors when
# IDOS_FRAME_ANCESTORS is unset) and at runtime (POST /api/idos/session). Unset → the bridge is off.
IDOS_TITLE_IDS=
# iDos API base for the session check; unset → https://api.idosgames.com.
IDOS_API_BASE_URL=
# docker compose (edition stack) only: host ports of the edition web and game server (unset → 3100, 2667).
IDOS_WEB_PORT=
IDOS_GAME_PORT=

# ── docker compose only ──────────────────────────────────────────────────────────────────────────
# Host interface of the published ports (unset → 127.0.0.1, i.e. behind nginx; 0.0.0.0 → public).
WEB_BIND=
GAME_BIND=

# ── Dev / debug only (ignored or refused in production) ──────────────────────────────────────────
# Shift the world clock by N ms in the web and the game server (same value in both).
WORLD_DEV_CLOCK_OFFSET_MS=
# Game server: 1 → scripted smoke-test hooks (never in production).
GAME_TEST_HOOKS=
# Game server: 1 → per-room tick timing logs.
BATTLE_PERF_LOG=
# Game server: legacy → the old map (never in production).
EXTRACT_MATCH_MAP=
# drizzle.config.ts: 1 → fail instead of falling back when DATABASE_URL is missing (set by the migrate image).
DRIZZLE_REQUIRE_DB=

# ── Art generation (scripts/gen-image.mjs, scripts/gen-lobby-art.mjs) ────────────────────────────
OPENAI_API_KEY=
# Image model id (unset → gpt-image-2; list: node scripts/gen-image.mjs --list-models).
# OPENAI_IMAGE_MODEL=
