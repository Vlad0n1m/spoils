# Postgres (Neon or local). After :port the path segment IS the database name — required.
# Wrong: postgres://u:p@localhost:5432  (no DB → libpq uses your OS login as DB name)
# Right:  ... :5432/extract
# Create DB once: createdb extract   (or: psql -c "CREATE DATABASE extract;")
# drizzle-kit reads repo root .env — see apps/web/drizzle.config.ts
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/extract
# If the password has ! @ # etc., URL-encode it (! → %21, @ → %40)

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
HOT_WALLET_SECRET_B58=
# Required when NODE_ENV=production: 64 hex chars (32 bytes). Per-user deposit pubkeys are HMAC-SHA512(master, userId).
MASTER_SEED_HEX=

# Auth (iron-session: min 32 characters — this line is 40+ chars)
SESSION_SECRET=replace-with-32-byte-random-hex-abcdef00
# Optional: force Set-Cookie Secure (default: true if X-Forwarded-Proto=https or production)
# Nginx: proxy_set_header X-Forwarded-Proto $scheme;
# SESSION_COOKIE_SECURE=true

# Game server <-> Web shared HMAC (min 16 in API; use 32+ like above)
GAME_SERVER_HMAC_SECRET=replace-with-32-byte-random-hex-abcdef00

# Public
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
# Optional: JSON map ISO country code -> wss URL for Colyseus. Server-only; not baked into the client.
# Example: send CIS players to a closer relay: {"KZ":"wss://game-cis.example.com","RU":"wss://game-cis.example.com"}
# Client may force a country (for testing) via localStorage key extract:game-server-prefer-country = KZ
# WORLD v6 runs one always-live world on one game server: leave this unset.
# GAME_SERVER_URL_BY_COUNTRY=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Cron auth (Vercel sets CRON_SECRET automatically; for local override)
CRON_SECRET=local-dev-cron-secret

# Game server settings
GAME_SERVER_PORT=2567
# Port must match `apps/web` `next dev` (default :3001). Use 127.0.0.1 so game-server fetch hits IPv4; `localhost` can fail (ECONNREFUSED) with Node + Next on 127.0.0.1 only.
WEB_API_BASE_URL=http://127.0.0.1:3001
# WORLD v6: stable id of this game server process group. Required when NODE_ENV=production (boot
# fails without it); a newer boot under the same id voids the maps of the previous instance.
# GAME_SERVER_ID=eu-1
# WORLD v6, optional: secret for the boss-event schedule (32+ bytes hex). Unset → derived from
# GAME_SERVER_HMAC_SECRET. Never reuse MASTER_SEED_HEX.
# WORLD_SEED_SECRET=
# WORLD v6, dev only (ignored in production): shifts the world clock of the web and the game server
# by this many ms, e.g. to jump to a minute before entry close or the wipe. Set the same value in both.
# WORLD_DEV_CLOCK_OFFSET_MS=0

# Optional: play without wallet (local / dev). Set both for UI + API.
GUEST_PLAY_ENABLED=true
NEXT_PUBLIC_GUEST_PLAY=1

# Wallet: "Add $100" test top-up (10_000 USD cents in DB). Off in production unless 1|true.
# Docker/Vercel: NEXT_PUBLIC_* is baked in at build — set below, then rebuild the web image / redeploy.
# NEXT_PUBLIC_WALLET_DEV_TOPUP=1


# OpenAI key for sprite/art generation (scripts/gen-image.mjs)
OPENAI_API_KEY=
# Image model id; check available ones with: node scripts/gen-image.mjs --list-models
OPENAI_IMAGE_MODEL=gpt-image-2
