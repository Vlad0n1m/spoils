*.log
.DS_Store
# Env files of any name (security audit: .env.production, .env.prod, .env.bak ... were not ignored);
# only the documented template is tracked.
.env
.env.*
!.env.example
.next
.turbo
.vercel
build
coverage
dist
drizzle/meta
node_modules
*.tsbuildinfo
# Solana program workspace (programs/): build output, local ledgers and keypairs never go to git
programs/target/
programs/.keys/
programs/.anchor/
programs/test-ledger/
programs/**/*-keypair.json
# Key material saved anywhere by habit (solana-keygen's default id.json, *keypair*.json, Android
# signing stores) and loose JSON next to the Anchor workspace (programs/idl/ stays tracked).
id.json
**/*keypair*.json
*.keystore
*.jks
programs/*.json
